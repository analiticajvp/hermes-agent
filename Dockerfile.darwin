# syntax=docker/dockerfile:1.7
# Darwin Docker image for Juan's LocalHermes deployment.
# Runtime knowledge is mounted at /data/hermes; secrets are never baked into this image.

FROM node:22-bookworm-slim@sha256:7af03b14a13c8cdd38e45058fd957bf00a72bbe17feac43b1c15a689c029c732 AS node_source
FROM ghcr.io/astral-sh/uv:0.11.6-python3.13-trixie@sha256:b3c543b6c4f23a5f2df22866bd7857e5d304b67a564f4feab6ac22044dde719b

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/darwin/src/.venv \
    HERMES_HOME=/data/hermes \
    HOME=/data/hermes \
    PATH=/opt/darwin/src/.venv/bin:/usr/local/bin:/usr/bin:/bin

RUN apt-get update && apt-get install -y --no-install-recommends \
      bash ca-certificates curl git openssh-client ripgrep fd-find jq sqlite3 \
      netcat-openbsd procps less nano vim-tiny tzdata \
      gcc g++ make cmake python3-dev libffi-dev libssl-dev libolm-dev \
      ffmpeg xz-utils tini \
    && rm -rf /var/lib/apt/lists/*

COPY --chmod=0755 --from=node_source /usr/local/bin/node /usr/local/bin/node
COPY --from=node_source /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
COPY --from=node_source /usr/local/lib/node_modules/corepack /usr/local/lib/node_modules/corepack
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && ln -sf /usr/local/lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack

# Compose runs Darwin as uid/gid 1000 so mounted knowledge files stay owned by
# the host operator.  Some tools (notably OpenSSH) require that uid to resolve
# through passwd/group, even when HOME is provided by the environment.
RUN grep -q '^darwin:' /etc/group || printf 'darwin:x:1000:\n' >> /etc/group \
    && grep -q '^darwin:' /etc/passwd || printf 'darwin:x:1000:1000:Darwin:/data/hermes:/bin/bash\n' >> /etc/passwd

WORKDIR /opt/darwin/src

# Copy full source only. Build context is LocalHermes/src, so HERMES_HOME secrets are out of scope.
COPY --link . .

# Python dependencies are exact/frozen via uv.lock. Extras mirror the production Hermes image
# plus Honcho/messaging providers that Darwin uses in Juan's ecosystem.
RUN uv sync --frozen --extra all --extra messaging --extra anthropic --extra bedrock \
      --extra azure-identity --extra hindsight --extra honcho \
    && uv pip install --no-cache-dir --no-deps -e .

# Build TUI/web artifacts needed by `hermes --tui` and dashboard-adjacent commands.
# npm install is used intentionally because this codebase's upstream Dockerfile uses it
# to support file: workspace links reliably across npm versions.
RUN npm install --prefer-offline --no-audit \
    && cd ui-tui && npm run build \
    && npm cache clean --force

RUN install -m 0755 docker/darwin-entrypoint.sh /usr/local/bin/Darwin \
    && install -m 0755 docker/engram-mcp-http-proxy.py /usr/local/bin/engram-mcp-http-proxy \
    && ln -sf /usr/local/bin/Darwin /usr/local/bin/darwin \
    && ln -sf /opt/darwin/src/.venv/bin/hermes /usr/local/bin/hermes \
    && mkdir -p /data/hermes /workspace \
    && chown -R 1000:1000 /data/hermes /workspace /opt/darwin/src/ui-tui/dist

VOLUME ["/data/hermes", "/workspace"]
WORKDIR /workspace
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/Darwin"]
